  "item": [
    {
      "name": "0. Registro Usuario Rol CONSULTA (/api/v1/auth/registro)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Código de estado 201 Created o 200 OK', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.access_token) {",
              "    pm.collectionVariables.set('consultaToken', jsonData.access_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"consulta@ipn.mx\",\n  \"password\": \"consulta123\",\n  \"name\": \"Estudiante Consulta\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "registro"
          ]
        },
        "description": "Registra un nuevo usuario que recibe por defecto el rol CONSULTA y guarda el token en {{consultaToken}}."
      }
    },
    {
      "name": "Prueba 1. Iniciar sesión con credenciales correctas (ADMIN)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Se obtiene un JWT válido (200 OK)', function () {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.access_token).to.be.a('string').and.not.empty;",
              "    pm.collectionVariables.set('adminToken', jsonData.access_token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@ipn.mx\",\n  \"password\": \"admin123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "description": "Prueba 1: Iniciar sesión con las credenciales del usuario ADMIN pre-cargado. Resultado esperado: Se obtiene un JWT válido."
      }
    },
